# Copy this to .env.heirvo and fill in your real values.
# .env.heirvo is gitignored — never commit the actual secrets.
#
# Product IDs: Lemon Squeezy Dashboard → Products → click each → read URL
#   app.lemonsqueezy.com/products/<ID>
HEIRVO_LS_RECOVER_PRODUCT_ID=
HEIRVO_LS_ARCHIVE_PRODUCT_ID=
HEIRVO_LS_FAMILY_PRODUCT_ID=

# HMAC secret for signing license.json (256-bit, base64).
# Generate one:
#   PS> $b = New-Object byte[] 32; [System.Security.Cryptography.RNGCryptoServiceProvider]::new().GetBytes($b); [Convert]::ToBase64String($b)
HEIRVO_LICENSE_HMAC_SECRET=

# Set to 1 ONLY for intentional internal test builds (skips product-ID gate).
# HEIRVO_ALLOW_DEV_LICENSE=1
