{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heirvo",
  "version": "1.1.0",
  "identifier": "com.heirvo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Heirvo",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: asset: https://asset.localhost; media-src 'self' blob: asset: https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://api.lemonsqueezy.com; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/com.heirvo.app/vault/**",
            "$DOCUMENT/**",
            "$VIDEO/**",
            "$PICTURE/**",
            "$MUSIC/**",
            "$DOWNLOAD/**",
            "$DESKTOP/**"
          ],
          "deny": [
            "$APPDATA/com.heirvo.app/license.key",
            "$APPDATA/com.heirvo.app/*.db",
            "$APPDATA/com.heirvo.app/*.log",
            "$APPDATA/com.heirvo.app/*.json",
            "$APPDATA/com.heirvo.app/*.key"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Heirvo",
    "shortDescription": "Recover damaged DVDs, photo CDs, and audio CDs",
    "longDescription": "Heirvo rescues data from damaged optical media — DVDs, photo CDs, document CDs, audio CDs. Multi-pass sector recovery, resumable sessions, AI restoration. Built for non-technical users.",
    "resources": [
      "resources/ffmpeg/ffmpeg.exe",
      "resources/ffmpeg/ffprobe.exe",
      "resources/whisper/whisper-cli.exe",
      "resources/whisper/ggml-base.en.bin",
      "resources/whisper/ggml.dll",
      "resources/whisper/ggml-base.dll",
      "resources/whisper/ggml-cpu.dll",
      "resources/whisper/whisper.dll"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "sidebarImage": "installer-sidebar.bmp",
        "headerImage": "installer-header.bmp",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": false
  }
}
