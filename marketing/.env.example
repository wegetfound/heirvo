# Heirvo marketing site — environment variables.
#
# DO NOT commit a real .env file. Set live values in the Cloudflare Pages
# dashboard (heirvo-marketing project → Settings → Environment variables).
#
# Each variable below must be set in the Cloudflare Pages dashboard (for
# production) AND a local `.env` file (for `npm run dev`). The local .env is
# git-ignored.

# Formspree form ID — handles mail-in order form submissions.
# Get yours at: https://formspree.io
VITE_FORMSPREE_ID=your_formspree_id

# Stripe Payment Link URL for the $19.99 mail-in intake fee.
# CRITICAL: must be the LIVE Payment Link (https://buy.stripe.com/<id>),
# NOT a test-mode link (https://buy.stripe.com/test_<id>). A test link
# will route real customers' charges to test mode and they never settle.
VITE_STRIPE_INTAKE_URL=https://buy.stripe.com/replace-me

# Lemon Squeezy checkout URLs (one-time purchases, no subscriptions).
# Get yours from each product page -> Share -> Checkout URL.
# VITE_LS_CHECKOUT_URL = Heirvo Recover ($59)
# VITE_LS_ARCHIVE_URL = Heirvo Archive ($99) — recommended tier
# VITE_LS_FAMILY_URL = Heirvo Family ($149) — 3-seat family plan
VITE_LS_CHECKOUT_URL=https://heirvo.lemonsqueezy.com/checkout/buy/replace-me
VITE_LS_ARCHIVE_URL=https://heirvo.lemonsqueezy.com/checkout/buy/replace-me
VITE_LS_FAMILY_URL=https://heirvo.lemonsqueezy.com/checkout/buy/replace-me

# Direct link to the latest installer (GitHub Releases, S3, etc.)
VITE_DOWNLOAD_URL=https://github.com/JungleLivingPai/heirvo/releases/latest/download/Heirvo_1.0.0_x64-setup.exe

# Airtable — Lab Network operator intake (/labs/apply → Operators table).
# Create a Personal Access Token at airtable.com/create/tokens scoped to:
#   data.records:write  on the Labs base ONLY (write-only keeps the token safe in the bundle).
# Base ID is visible in your base URL: airtable.com/appXXXXXXXXX/...
VITE_AIRTABLE_PAT=patXXXXXXXXXXXXXX
VITE_AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
